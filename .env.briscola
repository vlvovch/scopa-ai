# Build variant: Briscola AI
# Loaded automatically by Vite when invoked with `--mode briscola`.
# Values here are substituted into index.html as %VITE_FOO% placeholders
# and exposed to code as import.meta.env.VITE_FOO.

VITE_GAME=briscola
# No itch build for Briscola; defined so index.html's %VITE_ITCH_MODE% resolves.
VITE_ITCH_MODE=false
# SW static-cache version — bump ONLY when media files (cards, sounds,
# icons) change under an unchanged URL; see public/sw.js.
# v2: new app icon (trump-under-deck), 2026-08-22.
VITE_STATIC_CACHE_VER=v2
VITE_APP_NAME=Briscola AI
VITE_APP_DESCRIPTION=Play the classic Italian card game Briscola against AI opponents
VITE_THEME_COLOR="#1A237E"
VITE_ICON_PATH=/briscola-icon.svg
# Canonical origin — used for absolute og:url / og:image (social shares)
# and <link rel=canonical>. playbriscola.com is the primary domain; the
# old briscola-ai.vovchenko.net keeps serving the app (installed PWAs
# are bound to it) but is no longer canonical.
VITE_SITE_URL=https://playbriscola.com
