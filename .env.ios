# Build variant: the packaged iOS app (Capacitor).
# Loaded by Vite for `--mode ios` (see package.json "build:ios"). Both games
# ship in this bundle; Scopa is the site default the chooser lists first.
#
# Precedence reminder: .env.ios.local > .env.ios > .env.local > .env.
# Every value the app needs is set HERE explicitly so nothing from a
# developer's .env.local (localhost proxy, analytics ids) leaks into the
# native bundle. The API keys are deliberately empty: users bring their own
# and they are kept in the iOS Keychain (src/platform/storage.ts).

VITE_GAME=scopa
VITE_NATIVE=true
VITE_ITCH_MODE=false
VITE_STATIC_CACHE_VER=v1
VITE_APP_NAME=Scopa AI
VITE_APP_DESCRIPTION=Play the classic Italian card games Scopa and Briscola against AI opponents
VITE_THEME_COLOR="#1B5E20"
VITE_ICON_PATH=/scopa-icon.svg
VITE_SITE_URL=https://playscopa.net

# Production backends (explicit; the localhost fallbacks must never ship).
VITE_WS_URL=wss://playscopa.net/ws
VITE_BRISCOLA_WS_URL=wss://playbriscola.com/ws
VITE_PROXY_URL=https://playscopa.net

# Sound effects format in the app bundle: wav (PCM, the only format the
# iPad-on-Mac runtime decodes; MP3 and AAC both fail there) or m4a (AAC).
# See docs/ios.md, Sounds.
VITE_NATIVE_SOUND_FORMAT=wav

# Never bake keys into the app.
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_CLAUDE_API_KEY=
VITE_OPENROUTER_API_KEY=

# Analytics (Swetrix, cookieless): the app reports to the Scopa website's
# project, every gameplay event carries the game. The tag is added by
# src/analytics/loader.ts only where src/analytics/gate.ts allows it: a
# Release build, compiled without DEBUG, on a real device. Debug builds
# and the iOS Simulator carry these values too and send nothing. The
# project id is public (it is in the website's page as well). See
# docs/analytics.md.
VITE_SWETRIX_SCRIPT_URL=https://swetrix.org/swetrix.js
VITE_SWETRIX_API_URL=https://swetrix-api.vovchenko.net/log
VITE_SWETRIX_PROJECT_ID=BNvXSFeitwb8
