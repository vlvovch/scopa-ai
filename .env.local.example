# AI API Keys (optional - can also be added in Settings)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_CLAUDE_API_KEY=your-claude-api-key
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Itch.io build mode (disables API key entry, shows redirect to main site)
# VITE_ITCH_MODE=true

# Free AI Proxy URL (Cloudflare Worker - enables free AI without API keys)
# VITE_PROXY_URL=http://localhost:8787

# Multiplayer WebSocket Server URL (optional)
# Scopa build uses VITE_WS_URL; the separate Briscola build uses
# VITE_BRISCOLA_WS_URL. A Briscola build that only sets VITE_WS_URL will
# silently fall back to ws://localhost:8081.
VITE_WS_URL=ws://localhost:8080
VITE_BRISCOLA_WS_URL=ws://localhost:8081

# Analytics (optional, Swetrix). The tag is added at runtime only where
# src/analytics/gate.ts allows it: production builds on public hosts and
# Release builds on real devices. The dev server, vite preview, localhost,
# *.test / *.local hosts, LAN addresses, native Debug builds and the iOS
# Simulator load nothing and send nothing, so the id may stay here.
# To verify analytics, use a SEPARATE test project id (never the
# production one) and override the values on the command line when
# building; see docs/analytics.md.
# VITE_SWETRIX_SCRIPT_URL=https://swetrix.org/swetrix.js
# VITE_SWETRIX_API_URL=your-swetrix-api-url
# VITE_SWETRIX_PROJECT_ID=your-swetrix-project-id
