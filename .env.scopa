# Build variant: Scopa AI
# Loaded automatically by Vite when invoked with `--mode scopa`.
# Values here are substituted into index.html as %VITE_FOO% placeholders
# and exposed to code as import.meta.env.VITE_FOO.

VITE_GAME=scopa
# Overridden to true only by the build:itch script (inline env).
VITE_ITCH_MODE=false
VITE_APP_NAME=Scopa AI
VITE_APP_DESCRIPTION=Play the classic Italian card game Scopa against AI opponents
VITE_THEME_COLOR="#1B5E20"
VITE_ICON_PATH=/scopa-icon.svg
# Canonical origin — used for absolute og:url / og:image (social shares)
# and <link rel=canonical>. playscopa.net is the primary domain; the old
# scopa-ai.vovchenko.net keeps serving the app (Android TWA + installed
# PWAs are bound to it) but is no longer canonical.
VITE_SITE_URL=https://playscopa.net
