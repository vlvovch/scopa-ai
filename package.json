{
  "name": "scopa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode scopa",
    "dev:briscola": "vite --mode briscola",
    "build": "tsc -b && vite build --mode scopa",
    "build:scopa": "tsc -b && vite build --mode scopa",
    "build:briscola": "tsc -b && vite build --mode briscola --outDir dist-briscola",
    "build:itch": "tsc -b && VITE_ITCH_MODE=true vite build --mode scopa --outDir dist-itch --base=./",
    "build:itch:briscola": "tsc -b && VITE_ITCH_MODE=true vite build --mode briscola --outDir dist-itch-briscola --base=./",
    "build:ios": "tsc -b && vite build --mode ios --outDir dist-ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:briscola": "vite preview --outDir dist-briscola",
    "preview:itch": "vite preview --outDir dist-itch",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "ios:install": "xcrun simctl install booted ios/build/Build/Products/Debug-iphonesimulator/App.app && xcrun simctl launch --console-pty booted net.vovchenko.scopaai"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^1.34.0",
    "framer-motion": "^11.15.0",
    "openai": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.0.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
